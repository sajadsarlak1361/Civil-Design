{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Civil-Design",
  "mainBinaryName": "civil-design",
  "version": "0.2.3",
  "identifier": "com.civildesign.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:43123",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Civil Design",
        "width": 1440,
        "height": 900,
        "resizable": true,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' blob: 'unsafe-eval' 'wasm-unsafe-eval'; worker-src 'self' blob:; child-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://tauri.localhost https://tauri.localhost blob: data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "deb", "appimage"],
    "copyright": "Copyright (c) 2026 Sajad Sarlak. All rights reserved.",
    "shortDescription": "Civil Design",
    "longDescription": "Civil Design terrain surfaces",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["fieldline"],
        "name": "Civil Design Project",
        "description": "Civil Design project",
        "mimeType": "application/vnd.fieldline.project",
        "role": "Editor"
      },
      {
        "ext": ["dxf"],
        "name": "DXF drawing",
        "description": "DXF drawing",
        "mimeType": "image/vnd.dxf",
        "role": "Editor"
      },
      {
        "ext": ["dwg", "dwt"],
        "name": "DWG drawing",
        "description": "DWG drawing",
        "mimeType": "image/vnd.dwg",
        "role": "Editor"
      }
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
